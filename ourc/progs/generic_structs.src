struct Pair<T> { a: T, b: T }
struct P { x: int, y: int }
fn sumi(p: Pair<int>) -> int { p.a + p.b }
fn inner(p: Pair<P>) -> int { let f = p.a; let g = p.b; f.x + f.y + g.x + g.y }
let i: Pair<int> = Pair { 20, 22 };
print_int(sumi(&i));
let q: Pair<P> = Pair { P { 1, 2 }, P { 3, 4 } };
print_int(inner(&q));
sumi(&i) + inner(&q) - 10
