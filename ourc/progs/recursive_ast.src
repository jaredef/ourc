enum Ex { Num(int), Add(Ex, Ex), Mul(Ex, Ex), Neg(Ex) }
fn eval(e: Ex) -> int {
  match e {
    Num(v) => v,
    Add(a, b) => eval(&a) + eval(&b),
    Mul(a, b) => eval(&a) * eval(&b),
    Neg(a) => 0 - eval(&a)
  } }
fn depth(e: Ex) -> int {
  match e {
    Num(v) => 1,
    Add(a, b) => { let x = depth(&a); let y = depth(&b); if x < y { y + 1 } else { x + 1 } },
    Mul(a, b) => { let x = depth(&a); let y = depth(&b); if x < y { y + 1 } else { x + 1 } },
    Neg(a) => depth(&a) + 1
  } }
let t = Ex::Add(Ex::Mul(Ex::Num(6), Ex::Num(7)), Ex::Neg(Ex::Num(0)));
print_int(eval(&t));
print_int(depth(&t));
eval(&t)
