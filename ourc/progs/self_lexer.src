struct Lx { s: str, i: int, kinds: Vec<int>, los: Vec<int>, his: Vec<int> }
fn at(l: Lx) -> int { if l.i < len(l.s) { str_at(l.s, l.i) } else { 0 } }
fn adv(l: Lx) -> int { l.i = l.i + 1; 0 }
fn isd(c: int) -> int { if c >= 48 { if c <= 57 { 1 } else { 0 } } else { 0 } }
fn isa(c: int) -> int { if c >= 97 { if c <= 122 { 1 } else { 0 } } else { if c == 95 { 1 } else { 0 } } }
fn emit(l: Lx, k: int, a: int, b: int) -> int { l.kinds.push(k); l.los.push(a); l.his.push(b); 0 }
fn lex(src: str) -> Lx {
  let ks: Vec<int> = vec_new();
  let as2: Vec<int> = vec_new();
  let bs: Vec<int> = vec_new();
  let l = Lx { src, 0, ks, as2, bs };
  while l.i < len(l.s) {
    let c = at(&mut l);
    if c == 32 { adv(&mut l); }
    else {
      let st = l.i;
      if isd(c) == 1 { while isd(at(&mut l)) == 1 { adv(&mut l); } emit(&mut l, 1, st, l.i); }
      else {
        if isa(c) == 1 { while isa(at(&mut l)) == 1 { adv(&mut l); } emit(&mut l, 2, st, l.i); }
        else {
          if c == 61 { adv(&mut l); if at(&mut l) == 61 { adv(&mut l); emit(&mut l, 4, st, l.i); } else { emit(&mut l, 3, st, l.i); } }
          else { adv(&mut l); emit(&mut l, 9, st, l.i); }
        }
      }
    }
  }
  l }
fn count_kind(l: Lx, k: int) -> int { let mut n = 0; for x in l.kinds { if x == k { n = n + 1; } } n }
let t = lex("let x = 12 + y; if x == 3 { foo }");
print_int(t.kinds.len());
print_int(count_kind(&t, 2));
print_int(count_kind(&t, 1));
print_int(count_kind(&t, 4));
t.kinds.len() * 3
