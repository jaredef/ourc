add_eax_i ffffff00
and_eax_i 000000ff
cmp_eax_i 00000007
jb }heaptop_done
sub_eax_i 00000007
mov_at_eax f0f04600
:heaptop_done
mov_at_rbx 00f04600       # LINE = INBUF
# label-table stacks for NESTED loops: LP_SP 0x46f008 -> LP_STACK 0x46e000,
#                                       BRZ_SP 0x46f010 -> BRZ_STACK 0x46e800
# NOTE (T11): a naive relocation of LP/BRZ into the FIX_LIST hole was REVERTED. It turned
# nested-loops from deterministic-64 to flaky-64 (LP_STACK was no longer the binding constraint)
# but RESHUFFLED the rest of the cfprobe surface instead of raising rho*; the fuzzer CF_CRASH count
# is noise-dominated (98-113 band, non-deterministic) so showed no attributable change. The cf
# overflow is COOPERATIVE-COUPLED (SIPE-T Doc 541 §3.1): the tables share ONE corruption region in
# the cramped [0x460000,0x470000), so moving one within it shifts the collision rather than removing
# it. The real fix DECOUPLES them into genuinely separate mapped regions (extend cf memsz).
mov_eax_i 00e04600
mov_at_rax 08f04600
mov_eax_i 00e84600
mov_at_rax 10f04600
mov_eax_i 00004100        # R5: FN_END = FN_TABLE base 0x410000 (relocated into freed INBUF space -- 20k fns)
mov_at_eax 38f04600
mov_eax_i 00004200        # R5: FIX_END = FIX_LIST base 0x420000 (relocated; 4096 fixups)
mov_at_eax 40f04600
mov_eax_i 00004300        # FADDR_FIX_END = FADDR_FIX_LIST base 0x464000 (forward faddr fixups)
mov_at_eax 98f04600
mov_eax_i 00204600        # LBL_END/GFX_END for `ir main` (helpers reset in d_fn): goto labels+fixups
mov_at_eax 80f04600
mov_eax_i 00304600
mov_at_eax 88f04600
mov_eax_i 00c04600        # BK_SP = BREAK_STACK base (per-loop break-chain heads)
mov_at_rax 48f04600
mov_eax_i 00b04600        # CT_SP = CONT_STACK base (per-loop continue-chain heads)
mov_at_rax 50f04600
mov_esi_i =rbx_init       # output's 1st instr: ebx = slot base (the frame ptr)
mov_edx_i 05000000
call }emit_bytes
mov_esi_i =entry_marshal   # then materialize argc/argv/envp into low buffers (i32-clean)
mov_edx_i 86000000        # 134 bytes
call }emit_bytes
:heaptop_patch           # +DELTA into the emitted frame-base imm (rbx_init@OUTBUF+1) and the marshaller's
                         # argv(+11)/strings(+17)/envp(+79) dests, so the frame/argv region lifts together.
mov_eax_at 01004700
add_eax_at f0f04600
mov_at_eax 01004700
mov_eax_at 10004700
add_eax_at f0f04600
mov_at_eax 10004700
mov_eax_at 16004700
add_eax_at f0f04600
mov_at_eax 16004700
mov_eax_at 54004700
add_eax_at f0f04600
mov_at_eax 54004700

:lineloop
