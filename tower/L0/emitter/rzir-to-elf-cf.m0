# === emitter ELF header ===
7f454c46 02010100 00000000 00000000
0200 3e00 01000000
=code 00000000
40000000 00000000
00000000 00000000
00000000 4000 3800 0100 0000 00000000
01000000 07000000
00000000 00000000
00004000 00000000
00004000 00000000
&end 00000000
00004001 00000000
00100000 00000000

# === OUTPUT 120-byte header (R+W+X; filesz patched; slots at 0x410000) ===
:ohdr
7f454c46 02010100 00000000 00000000
0200 3e00 01000000
78004000 00000000
40000000 00000000
00000000 00000000
00000000 4000 3800 0100 0000 00000000
01000000 07000000
00000000 00000000
00004000 00000000
00004000 00000000
:fsz 00000000 00000000
:msz 00000010 00000000
00100000 00000000

# === code ===
:code
mov_esi_i 00000001        # R5: rsi = INBUF 0x1000000 (relocated above the tables --
                          # cf memsz is 20MB @0x400000, so 0x1000000-0x1800000 = 8MB INBUF)
                          # input up to the tables @0x461000, was 64KB @0x440000). cf's own process;
                          # the compiled program's slots @0x410000 are a separate address space.
:rdloop                   # LOOP read() until EOF: a PIPE delivers the rzir in chunks; a single
xor_eax_eax               # read() returned a truncated input -> non-deterministic cf crash. Loop.
xor_edi_edi
mov_edx_i 00000100        # count = 0x10000 per read
syscall                   # read(0, rsi, 0x10000) -> rax = bytes read
test_eax_eax
je }rddone                # 0 = EOF -> done
add_rax_rsi               # rsi += rax  (advance the write pointer)
mov_rsi_rax
cmp_eax_i 00008001        # R5: INBUF ceiling 0x1800000 (decoupled from FIX_LIST @0x461000)
jae }in_overflow          # rzir exceeds cf's ~324KB INBUF. Exit deterministically, not silent-truncate.
jmp }rdloop
:in_overflow
mov_eax_i 3c000000        # exit(8) -- cf INBUF overflow. The decoupling (relocate tables for a bigger
mov_edi_i 08000000        # INBUF) is the follow-on if cc-in-C's rzir needs >324KB.
syscall
:rddone
mov_ebx_i 00000001        # R5: ebx = INBUF 0x1000000 (base for line-relative math)
mov_r13_rsi               # r13 = end of accumulated input
mov_r15d_i 00004700       # OUTBUF write pointer
:heaptop_scan            # HEAPTOP: per-program dynamic frame base (mirrors cf.hoist scan_heaptop).
                         # If input's 1st line is "heaptop <N>", DELTA@0x46f0f0 = align16MB(N)-0x7000000
                         # (so frame base = 0x8000000+DELTA = align16MB(N)+16MB); else DELTA=0 -> every
                         # emitted constant (frame base, SPILL, memsz, argv/envp/strings) is +DELTA and
                         # a no-heaptop program is BYTE-IDENTICAL to the pre-heaptop cf. arena_top@0x46f0f8.
xor_eax_eax
mov_at_eax f0f04600
mov_at_eax f8f04600
mov_eax_at 00000001
cmp_eax_i 68656170
jne }heaptop_done
mov_eax_at 03000001
cmp_eax_i 70746f70
jne }heaptop_done
mov_eax_i 07000001
:heaptop_sp
movzx_at_rax
cmp_dl_20
jne }heaptop_dig
inc_rax
jmp }heaptop_sp
:heaptop_dig
movzx_at_rax
cmp_dl_30
jb }heaptop_val
cmp_dl_3a
jae }heaptop_val
push_rax
sub_edx_i 30000000
mov_eax_at f8f04600
mov_ecx_eax
add_eax_eax
add_eax_eax
add_eax_ecx
add_eax_eax
add_eax_edx
mov_at_eax f8f04600
pop_rax
inc_rax
jmp }heaptop_dig
:heaptop_val
