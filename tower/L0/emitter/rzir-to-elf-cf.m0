mov_at_eax b8f04600       # stream left in eax survives exactly one line; only bop_store
mov_eax_i ffffffff        # re-arms it, so any non-assignment line (all jump targets are
mov_at_eax b0f04600       # loop/pool/label/endloop/cont/fn lines) kills forwarding
