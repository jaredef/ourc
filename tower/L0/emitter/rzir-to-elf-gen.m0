# rzir -> ELF GENERAL codegen backend, authored in M0.
# A value-location model: every vN gets a runtime SLOT at 0x410000 + N*4 in the
# OUTPUT program's bss. Each assignment GENERATES real instructions -- const ->
# store-imm, argc -> load-[rsp]-store, op -> load/op/store -- and ret loads its
# slot and exits. Handles arbitrary SSA DAGs: multiple runtime values, a value
# used more than once (add v0 v0 = 2*argc), non-linear expressions. The OUTPUT
# code is variable-length, so the ELF p_filesz is computed and patched. No
# folding; everything is codegen'd. Built by M0. Verified by exit code. No cc.
#
# emitter bss: INBUF 0x440000, OUTBUF 0x470000.
# output bss:  vN slots at 0x410000 (the generated program's runtime memory).

# === instruction-encoding library ===
%xor_eax_eax    31c0
%xor_edi_edi    31ff
%syscall        0f05
%ret            c3
%jmp            e9
%call           e8
%ja             0f87
%je             0f84
%jz             0f84
%jne            0f85
%mov_eax_i      b8
%mov_edi_i      bf
%mov_esi_i      be
%mov_edx_i      ba
%mov_ebx_i      bb
%mov_r15d_i     41bf
%mov_al_03      b003
%mov_al_2b      b02b
%lea_r13_rbxrax 4c8d2c03
%lea_rsi_r14_6  498d7606
%mov_rdx_rbx    4889da
%mov_rdx_r14    4c89f2
%mov_rdx_r15    4c89fa
%mov_r14_rbx    4989de
%mov_r14_rax    4989c6
%mov_rdi_rax    4889c7
%mov_rsi_rax    4889c6
%mov_rax_r15    4c89f8
%mov_eax_ecx    89c8
%mov_ecx_r9d    4489c9
%shl_eax_2      c1e002
%add_eax_i      05
%sub_eax_i      2d
%sub_edx_i      81ea
%mov_at_eax     890425
%mov_r9d_eax    4189c1
%movzx_rax_4    0fb64004
%movzx_r14_d    410fb616
%movzx_r14_1    410fb65601
%movzx_r14_5c   410fb64e05
%movzx_r14_8c   410fb64e08
%movzx_r14_11c  410fb64e0b
%cmp_dl_65      80fa65
%movzx_rax_c    0fb608
%movzx_at_rsi   0fb606
%sub_al_30      2c30
%sub_cl_30      80e930
%cmp_dl_63      80fa63
%cmp_dl_72      80fa72
%cmp_dl_73      80fa73
# emit helpers (append to OUTBUF at r15)
%st_al_r15      418807
%st_eax_r15     418907
%inc_r15        49ffc7
%inc_rsi        48ffc6
%dec_rdx        48ffca
%test_rdx_rdx   4885d2
%add_r15_4      4983c704
# const-value parse (pd)
%movzx_rsi      0fb606
%sub_eax_30b    83e830
%movzx_rsi1     0fb65601
%sub_edx_30b    83ea30
%cmp_edx_9      83fa09
%imul_eax_10    6bc00a
%add_eax_edx    01d0
# find helpers
%mov_r8_rdx     4989d0
%mov_rax_r8     4c89c0
%add_rax_rsi    4801f0
%cmp_rax_r13    4c39e8
%xor_ecx_ecx    31c9
%cmp_rcx_rsi    4839f1
%movzx_r8rcx    410fb60408
%movzx_rdircx   0fb6140f
%cmp_al_dl      38d0
%inc_rcx        48ffc1
%inc_r8         49ffc0
%lea_rax_r8rsi  498d0430
%test_eax_eax   85c0
%mov_rax_rdi    4889f8
%movzx_rax_dl   0fb610
%cmp_dl_0a      80fa0a
%dec_rax        48ffc8

# === emitter ELF header (memsz 0x80000 to cover OUTBUF 0x470000) ===
7f454c46 02010100 00000000 00000000
0200 3e00 01000000
=code 00000000
40000000 00000000
00000000 00000000
00000000 4000 3800 0100 0000 00000000
01000000 07000000
00000000 00000000
00004000 00000000
00004000 00000000
&end 00000000
00000800 00000000
00100000 00000000

# === OUTPUT 120-byte header template (R+W+X; filesz patched; slots at 0x410000) ===
:ohdr
7f454c46 02010100 00000000 00000000
0200 3e00 01000000
78004000 00000000
40000000 00000000
00000000 00000000
00000000 4000 3800 0100 0000 00000000
01000000 07000000
00000000 00000000
00004000 00000000
00004000 00000000
:fsz 00000000 00000000
00100100 00000000
00100000 00000000

# === code ===
:code
xor_eax_eax
xor_edi_edi
mov_esi_i 00004400
mov_edx_i 00000100
syscall
mov_ebx_i 00004400
lea_r13_rbxrax
mov_r15d_i 00004700       # OUTBUF write pointer (0x470000)
mov_r14_rbx               # cursor

:aloop
mov_rdx_r14
mov_edi_i =asn_needle
mov_esi_i 06000000
call }find
test_eax_eax
jz }adone
mov_r14_rax               # cursor = RHS
mov_rdi_rax
call }scan_back_nl
movzx_rax_4
sub_al_30
mov_r9d_eax               # r9 = target vN
movzx_r14_d               # RHS[0]
cmp_dl_63
je }g_const
movzx_r14_1               # RHS[1]: 'r' -> argc, 'e' -> sel, else add/sub
cmp_dl_72
je }g_argc
cmp_dl_65
je }g_sel
# --- op: load X, op Y, store N ---
mov_esi_i =pre_movrm      # 8b 04 25
mov_edx_i 03000000
call }emit_bytes
movzx_r14_5c
sub_cl_30
call }emit_slot           # SLOT_X
movzx_r14_d
cmp_dl_73                 # 's' -> sub (2b), else add (03)
je }op_sub
mov_al_03
jmp }op_emit
:op_sub
mov_al_2b
:op_emit
st_al_r15
inc_r15
mov_esi_i =pre_rm         # 04 25
mov_edx_i 02000000
call }emit_bytes
movzx_r14_8c
sub_cl_30
call }emit_slot           # SLOT_Y
mov_esi_i =pre_movmr      # 89 04 25
mov_edx_i 03000000
call }emit_bytes
mov_ecx_r9d
call }emit_slot           # SLOT_N
jmp }aloop
:g_const
mov_esi_i =pre_movmi      # c7 04 25
mov_edx_i 03000000
call }emit_bytes
mov_ecx_r9d
call }emit_slot           # SLOT_N
lea_rsi_r14_6
call }pd
st_eax_r15                # imm32 = value
add_r15_4
jmp }aloop
:g_argc
mov_esi_i =pre_argc       # 48 8b 04 24 89 04 25
mov_edx_i 07000000
call }emit_bytes
mov_ecx_r9d
call }emit_slot           # SLOT_N
jmp }aloop
:g_sel
# sel vC vA vB -> branch:  mov eax,[C]; test; jz else; mov ecx,[A]; jmp end;
#                          else: mov ecx,[B]; end: mov [N],ecx   (fixed offsets)
mov_esi_i =pre_movrm      # mov eax, [SLOT_C]
mov_edx_i 03000000
call }emit_bytes
movzx_r14_5c
sub_cl_30
call }emit_slot
mov_esi_i =sel_mid1       # test eax,eax ; jz +12
mov_edx_i 08000000
call }emit_bytes
mov_esi_i =pre_movrc      # mov ecx, [SLOT_A]   (then)
mov_edx_i 03000000
call }emit_bytes
movzx_r14_8c
sub_cl_30
call }emit_slot
mov_esi_i =sel_mid2       # jmp +7
mov_edx_i 05000000
call }emit_bytes
mov_esi_i =pre_movrc      # mov ecx, [SLOT_B]   (else)
mov_edx_i 03000000
call }emit_bytes
movzx_r14_11c
sub_cl_30
call }emit_slot
mov_esi_i =pre_movmc      # mov [SLOT_N], ecx
mov_edx_i 03000000
call }emit_bytes
mov_ecx_r9d
call }emit_slot
jmp }aloop
:adone

# ret: load SLOT_ret, exit
mov_rdx_rbx
mov_edi_i =ret_needle
mov_esi_i 05000000
call }find
movzx_rax_c
sub_cl_30
mov_esi_i =pre_movdi      # 8b 3c 25
mov_edx_i 03000000
call }emit_bytes
call }emit_slot           # SLOT_ret
mov_esi_i =post_exit      # b8 3c 00 00 00 0f 05
mov_edx_i 07000000
call }emit_bytes

# wrap: filesz = 120 + (r15 - OUTBUF) ; write ohdr(120) + OUTBUF(L)
mov_rax_r15
sub_eax_i 00004700        # L = r15 - OUTBUF
add_eax_i 78000000        # + 120 = filesz
mov_at_eax =fsz
mov_eax_i 01000000
mov_edi_i 01000000
mov_esi_i =ohdr
mov_edx_i 78000000        # 120
syscall
mov_eax_i 01000000
mov_edi_i 01000000
mov_esi_i 00004700
mov_rdx_r15
sub_edx_i 00004700        # L
syscall
mov_eax_i 3c000000
xor_edi_edi
syscall

# emit_bytes: rsi=src rdx=len -> append to [r15]
:emit_bytes
:eb_l
test_rdx_rdx
jz }eb_done
movzx_at_rsi
st_al_r15
inc_r15
inc_rsi
dec_rdx
jmp }eb_l
:eb_done
ret

# emit_slot: ecx = vN digit -> append the 4-byte slot address (0x410000 + N*4)
:emit_slot
mov_eax_ecx
shl_eax_2
add_eax_i 00004100
st_eax_r15
add_r15_4
ret

# find: rdi=needle rsi=len rdx=start -> rax = ptr after match, or 0
:find
mov_r8_rdx
:f_outer
mov_rax_r8
add_rax_rsi
cmp_rax_r13
ja }f_none
xor_ecx_ecx
:f_inner
cmp_rcx_rsi
je }f_hit
movzx_r8rcx
movzx_rdircx
cmp_al_dl
jne }f_next
inc_rcx
jmp }f_inner
:f_next
inc_r8
jmp }f_outer
:f_hit
lea_rax_r8rsi
ret
:f_none
xor_eax_eax
ret

# pd: rsi -> eax = 1-2 digit decimal
:pd
movzx_rsi
sub_eax_30b
movzx_rsi1
sub_edx_30b
cmp_edx_9
ja }pd_one
imul_eax_10
add_eax_edx
:pd_one
ret

# scan_back_nl: rdi -> rax = preceding newline (so [rax+4] is the line's vN)
:scan_back_nl
mov_rax_rdi
:sbn_loop
dec_rax
movzx_rax_dl
cmp_dl_0a
jne }sbn_loop
ret

