# rzir -> ELF emitter (2-const-1-op) authored against hex2: NO hand-computed
# addresses, NO measuring build. e_entry = =m, p_filesz = &z, INBUF = =z,
# all data/needle/template/patch-slot addresses are = label refs. The off-by-4
# class cannot occur here: every address is computed by hex2 from the layout.

# === emitter ELF header (64) ===
7f 45 4c 46 02 01 01 00  00 00 00 00 00 00 00 00
02 00 3e 00 01 00 00 00
=m 00 00 00 00         # e_entry  (symbolic)
40 00 00 00 00 00 00 00   # e_phoff 64
00 00 00 00 00 00 00 00   # e_shoff
00 00 00 00 40 00 38 00 01 00 00 00 00 00 00 00
# === program header (56) PT_LOAD R+W+X ===
01 00 00 00 07 00 00 00
00 00 00 00 00 00 00 00
00 00 40 00 00 00 00 00
00 00 40 00 00 00 00 00
&z 00 00 00 00          # p_filesz = &z  (symbolic file size)
00 00 02 00 00 00 00 00   # p_memsz 0x20000  (fixed; covers INBUF's 64 KiB)
00 10 00 00 00 00 00 00

# === OUTPUT template (149), labels at the patch slots ===
:t
7f 45 4c 46 02 01 01 00  00 00 00 00 00 00 00 00
02 00 3e 00 01 00 00 00
78 00 40 00 00 00 00 00
40 00 00 00 00 00 00 00
00 00 00 00 00 00 00 00
00 00 00 00 40 00 38 00 01 00 00 00 00 00 00 00
01 00 00 00 05 00 00 00
00 00 00 00 00 00 00 00
00 00 40 00 00 00 00 00
00 00 40 00 00 00 00 00
95 00 00 00 00 00 00 00
95 00 00 00 00 00 00 00
00 10 00 00 00 00 00 00
49 c7 c1 :a 00 00 00 00   # mov $A,%r9   (:a labels the A immediate)
49 c7 c2 :b 00 00 00 00   # mov $B,%r10  (:b labels the B immediate)
4d :p 01 d1               # add %r10,%r9 (:p labels the op byte)
4c 89 cf                  # mov %r9,%rdi
48 c7 c0 3c 00 00 00      # mov $60,%rax
0f 05                     # syscall

# === needles ===
:k
63 6f 6e 73 74 20         # "const "
:s
73 75 62 20               # "sub "

# === code ===
:m
31 c0                     # xor eax,eax
31 ff                     # xor edi,edi
be =z                   # mov esi, INBUF (=z)
ba 00 00 01 00            # mov edx, 65536
0f 05                     # syscall
bb =z                   # mov ebx, INBUF
4c 8d 2c 03               # lea r13,[rbx+rax]
bf =k                    # mov edi, "const "
be 06 00 00 00            # mov esi, 6
48 89 da                  # mov rdx, rbx
e8 }F                     # call find
49 89 c4                  # mov r12, rax
48 89 c6                  # mov rsi, rax
e8 }P                     # call pd
41 89 c6                  # mov r14d, eax   (A)
bf =k                    # mov edi, "const "
be 06 00 00 00            # mov esi, 6
4c 89 e2                  # mov rdx, r12
e8 }F                     # call find
48 89 c6                  # mov rsi, rax
e8 }P                     # call pd
41 89 c7                  # mov r15d, eax   (B)
bf =s                    # mov edi, "sub "
be 04 00 00 00            # mov esi, 4
48 89 da                  # mov rdx, rbx
e8 }F                     # call find
48 85 c0                  # test rax,rax
0f 84 }N                  # jz noop
c6 04 25 =p 29            # movb $0x29, [=p]  (op = sub)
:N
44 89 34 25 =a            # mov [=a], r14d    (patch A)
44 89 3c 25 =b            # mov [=b], r15d    (patch B)
b8 01 00 00 00            # mov eax,1
bf 01 00 00 00            # mov edi,1
be =t                     # mov esi, template
ba 95 00 00 00            # mov edx, 149
0f 05                     # syscall
b8 3c 00 00 00            # mov eax,60
31 ff                     # xor edi,edi
0f 05                     # syscall

# find: rdi=needle rsi=len rdx=start -> rax = ptr after match, or 0
:F
49 89 d0
:O
4c 89 c0
48 01 f0
4c 39 e8
0f 87 }Z
31 c9
:I
48 39 f1
0f 84 }H
41 0f b6 04 08
0f b6 14 0f
38 d0
0f 85 }X
48 ff c1
e9 }I
:X
49 ff c0
e9 }O
:H
49 8d 04 30
c3
:Z
31 c0
c3

# pd: rsi = ptr -> eax = 1-2 digit decimal
:P
0f b6 06
83 e8 30
0f b6 56 01
83 ea 30
83 fa 09
0f 87 }Q
6b c0 0a
01 d0
:Q
c3
:z
