# multi-function setup: bound r13 to each fn's `end`; FN_START scopes the scans
mov_at_r13 78004600       # INPUT_END = full input end
mov_at_rbx 90004600       # FN_START = INBUF (main)
xor_eax_eax
mov_at_eax 70004600       # FN_PHASE = 0 (main)
mov_rdx_at 90004600               # r13 = main's "end"
mov_edi_i =end_needle
mov_esi_i 03000000
call }find
mov_r13_rax

:fn_body
mov_edi_i =if_needle      # CONS_POS = position of the if/loop construct (or fn end)
mov_esi_i 03000000
mov_rdx_at 90004600
call }find
test_eax_eax
jne }cons_set
mov_edi_i =loop_needle
mov_esi_i 05000000
