# arm64 code fixture: backward branch reference.
# This is code bytes only, not a Mach-O container.
#
# Layout:
#   A: exit(42)
#   exit(1)
#   @A
#
# @A starts at byte offset 24 and targets byte offset 0:
#   imm26 = (0 - 24) >> 2 = -6
#   word = 0x14000000 | (imm26 & 0x03ffffff) = 0x17fffffa
#   little-endian bytes: fa ff ff 17
:A
40 05 80 d2   # mov x0, #42
30 00 80 d2   # mov x16, #1
01 10 00 d4   # svc #0x80
20 00 80 d2   # mov x0, #1
30 00 80 d2   # mov x16, #1
01 10 00 d4   # svc #0x80
@A
