# arm64 code fixture: branch-with-link to an exit routine.
# This is code bytes only, not a Mach-O container.
#
# !A should emit:
#   bl A
# If here=0 and A is at byte offset 16, imm26=(16-0)>>2=4,
# so the branch word is 0x94000004 -> 04 00 00 94.
#
# Failing path: exit(1). Correct bl never returns because A exits 42.
!A
20 00 80 d2   # mov x0, #1
30 00 80 d2   # mov x16, #1
01 10 00 d4   # svc #0x80
:A
40 05 80 d2   # mov x0, #42
30 00 80 d2   # mov x16, #1
01 10 00 d4   # svc #0x80
