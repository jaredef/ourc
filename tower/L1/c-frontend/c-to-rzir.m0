mov_esi_i 00004100        # rsi = INBUF 0x410000 (moved down into the dead code gap: 256KB input,
                          # was 64KB @0x440000 -- m0-at-scale; cc.bin code ~21KB fits below 0x410000)
:rdloop                   # LOOP read() until EOF: a PIPE delivers the C source in chunks (>4KB
xor_eax_eax               # writes split), so a single read() truncated large sources -> CC_FAIL.
xor_edi_edi
mov_edx_i 00000100        # count = 0x10000 per read
syscall                   # read(0, rsi, 0x10000) -> rax = bytes read
test_eax_eax
je }rddone                # 0 = EOF -> done
add_rax_rsi               # rsi += rax  (advance the write pointer)
mov_rsi_rax
jmp }rdloop
:rddone
