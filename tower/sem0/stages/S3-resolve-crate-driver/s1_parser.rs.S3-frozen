            match self.peek() { Tok::Lifetime(_) => { self.bump(); }, _ => {} }   // `&'a self` / `&'a mut self` -- consume the explicit lifetime after `&` before `self`
            match self.peek() { Tok::Mut => { self.bump(); has_mut = true; }, _ => {} }
