            Tok::Amp => { got_self = true; }
            Tok::Ident(nm) => { if nm == String::from("self") { got_self = true; } }
            Tok::Mut => { match self.peek2() { Tok::Ident(nm) => { if nm == String::from("self") { got_self = true; } }, _ => {} } }   // by-value `mut self` receiver: leads with `mut` (not `&`); guard on peek2==self so `fn f(mut x: u8)` is NOT mistaken for a receiver. The got_self branch's line-734 `mut`-consume already handles it once detected.
